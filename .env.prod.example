# Copy to .env.prod on the server and fill in. Never commit .env.prod.
DOMAIN=attendance.yourcollege.edu
# Generate each with: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
TIMEZONE=Asia/Kolkata
# Public sign-up page: the first account becomes admin, later ones wait for approval.
# Set to false once your staff are set up if you prefer admin invites only.
ALLOW_SIGNUP=true
# Tune after a week of real use (uv run python scripts/calibrate.py)
MATCH_THRESHOLD=0.45
MATCH_MARGIN=0.08
